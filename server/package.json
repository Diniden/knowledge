{
  "name": "@kg/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun dist/main.js",
    "test": "bun test",
    "lint": "eslint src/",
