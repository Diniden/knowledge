{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["ui/src/*"],
      "@shared": ["../shared/src"]
    },
    "noEmit": true
  },
  "include": ["ui/src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
