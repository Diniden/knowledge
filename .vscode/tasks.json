{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Servers",
      "type": "shell",
      "command": "bun dev",
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "bun test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "bun lint",
      "problemMatcher": ["$eslint-stylish"]
    }
  ]
}
