# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kg_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=kg_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Auth
JWT_SECRET=change-this-in-production
JWT_EXPIRATION=7d

# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Agent (Phase 3+)
CLAUDE_API_KEY=

# RAG (Phase 2+)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Git
GIT_USER_NAME=KG Agent
GIT_USER_EMAIL=agent@local

# Logging
LOG_LEVEL=info

# Client (VITE_ prefix)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_WS_URL=ws://localhost:4000/ws
VITE_APP_NAME=Knowledge Graph Agent System
