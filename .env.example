# =============================================================================
# Knowledge Graph Agent System — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Port the NestJS server listens on
PORT=4000

# Node environment: development | production | test
NODE_ENV=development

# Allowed CORS origins (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3000

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

# Full connection URL (overrides individual settings below if provided)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=kg_development
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# Secret key for signing JWTs — use a strong random value in production
JWT_SECRET=change-me-to-a-secure-random-string-in-production

# Token expiration (e.g., 7d, 24h, 3600)
JWT_EXPIRATION=7d

# -----------------------------------------------------------------------------
# AI Agent
# -----------------------------------------------------------------------------

# Claude API key for the agent runtime
CLAUDE_API_KEY=

# Embedding API key (e.g., OpenAI API key)
EMBEDDING_API_KEY=

# Embedding model identifier
EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Git Integration
# -----------------------------------------------------------------------------

# Git committer identity for agent-authored commits
GIT_USER_NAME=Knowledge Graph Agent
GIT_USER_EMAIL=agent@kg.local

# -----------------------------------------------------------------------------
# Client (VITE_ prefixed — exposed to browser)
# -----------------------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
VITE_APP_NAME=Knowledge Graph Agent System
