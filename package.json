{
  "name": "kg-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared",
    "packages/*"
  ],
  "scripts": {
    "dev": "mprocs --config mprocs.yaml",
    "build": "bun run --filter @kg/shared build && bun run --filter @kg/server build && bun run --filter @kg/client build",
    "test": "bun test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "bun run scripts/clean.ts",
    "setup": "bun run scripts/setup.ts",
    "migrate": "bun run --filter @kg/server migrate",
    "seed": "bun run --filter @kg/server seed"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@types/bun": "^1.3.9",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "lefthook": "^2.1.2",
    "lint-staged": "^16.3.1",
    "mprocs": "0.8.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
