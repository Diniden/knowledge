# Test environment — used by CI and local test runs
PORT=4001
NODE_ENV=test
CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=error

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=kg_test
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

JWT_SECRET=test-only-jwt-secret
JWT_EXPIRATION=1h

CLAUDE_API_KEY=mock-claude-key
EMBEDDING_API_KEY=mock-embedding-key
EMBEDDING_MODEL=text-embedding-3-small

GIT_USER_NAME=Test Agent
GIT_USER_EMAIL=test-agent@kg.local

VITE_API_BASE_URL=http://localhost:4001
VITE_WS_URL=ws://localhost:4001
VITE_APP_NAME=KG System (Test)
